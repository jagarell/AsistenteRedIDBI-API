 "REF_RULE": {
  "R02": [
   "Raspberry para el controlador de impresiones",
   "Recomendar un kit Raspberry para instalar el controlador (sistema de impresiones). Solo trabaja con impresoras de red: no sirve si la impresora de caja es USB. El kit se cotiza con el equipo de Desarrollo de Negocios."
  ],
  "R03": [
   "Toma independiente para equipos de red",
   "Habilitar una toma independiente para los equipos de red y un supresor de picos exclusivo para ellos."
  ],
  "R05": [
   "Switch para ampliar un punto de red",
   "Instalar un switch de 4 a 8 puertos en el área para repartir la conexión (impresora, repetidor, caja)."
  ],
  "R06": [
   "Punto de red cerca de la impresora",
   "Instalar un punto de red cerca de la impresora antes de la siguiente visita."
  ],
  "R07": [
   "Gabinete de pared",
   "Adquirir un gabinete de pared de 4 RU, instalarlo a 1.65 m del piso y usar un supresor que solo alimente los equipos del gabinete."
  ],
  "R08": [
   "Separar cables eléctricos en el gabinete",
   "Ordenar el gabinete y mantener los cables eléctricos aislados de los de red."
  ],
  "R09": [
   "Cable Cat6 rotulado",
   "Cambiar los cables por Cat6 armados a medida y rotulados."
  ],
  "R10": [
   "Proteger equipos de grasa y calor",
   "Hacer cambios para evitar la acumulación de grasa en los equipos (reubicar o proteger)."
  ],
  "R11": [
   "PC de caja por cable",
   "Conectar la PC de caja al router o switch por cable Ethernet y reservar su IP en el DHCP."
  ],
  "R12": [
   "Impresoras conectadas directo a la red principal",
   "Conectar las impresoras por cable al router o a un switch de la red principal, no a través de repetidores."
  ],
  "R16": [
   "Impresora USB conectada al equipo con controlador",
   "Conectar la impresora USB a la laptop o PC que tiene el controlador de impresiones; así imprime comandas, pre-cuentas y comprobantes. Una impresora USB no funciona con Raspberry. Pasarla a red solo si debe imprimir sin depender de la PC."
  ],
  "R17": [
   "Plan de internet bajo",
   "Evaluar un plan de mayor ancho de banda."
  ],
  "R18": [
   "Switch administrable",
   "Centralizar las conexiones cableadas en un switch administrable."
  ],
  "R19": [
   "Cobertura WiFi en todo el local (repetidor o access point)",
   "Colocar un repetidor o un access point para cubrir las zonas sin señal. Todo el local (salones, terraza, barra) debe tener WiFi para que los meseros comanden."
  ],
  "R24": [
   "IP fija para impresoras de red",
   "Fijar la IP de la impresora dentro del segmento del router (desactivar DHCP)."
  ],
  "R26": [
   "Segunda visita técnica",
   "Agendar una segunda visita técnica (motivo en P50a)."
  ],
  "R27": [
   "Mantenimiento de equipos y tomas",
   "Dar mantenimiento a los equipos de red (router, módem, Raspberry) y limpiar las tomas de energía."
  ],
  "R29": [
   "Una sola red para POS e impresoras",
   "Conectar todas las PC de caja e impresoras a una misma red y dejar la otra solo como respaldo o para clientes."
  ],
  "R30": [
   "Rotular cables y no moverlos sin avisar",
   "Rotular los cables de red de cada equipo y no hacer cambios en el cableado sin informar antes a ID."
  ],
  "R31": [
   "Reemplazar switch defectuoso",
   "Reemplazar el switch defectuoso y medir la velocidad en cada PC después del cambio."
  ],
  "R32": [
   "Red WiFi definida para tablets",
   "Definir la red WiFi que usará cada tablet, probar su conexión una por una y separarla de la red de clientes cuando sea posible."
  ],
  "R33": [
   "Cambiar a un proveedor más estable",
   "Evaluar internet por fibra (o Starlink donde no llega la fibra) y monitorear el consumo del plan mientras tanto."
  ],
  "R34": [
   "Ubicar el Raspberry en un lugar protegido",
   "Mover el Raspberry a un punto protegido e inaccesible para el personal, con toma y punto de red propios."
  ],
  "R35": [
   "Zona horaria correcta en las PC",
   "Configurar la zona horaria de Perú (UTC-5) en todas las PC que usan el sistema."
  ],
  "R36": [
   "Dejar cargar el sistema antes de operar",
   "Esperar a que IDPos cargue por completo antes de operar, sobre todo después de actualizaciones."
  ],
  "R37": [
   "Cambiar conectores de red desgastados",
   "Cambiar los conectores RJ45 desgastados de las impresoras y probar la conexión."
  ],
  "R38": [
   "Impresora para área que prepara sin comandas",
   "Instalar una impresora ticketera de red en el área, con su punto de red, para comandas y pre-cuentas."
  ],
  "R39": [
   "Equipo de pedidos adicional por piso",
   "Contar con una tablet o monitor de pedidos adicional en el otro piso para agilizar el ingreso de órdenes."
  ],
  "R47": [
   "Tablet en caja: Raspberry obligatorio",
   "Es obligatorio adquirir un kit Raspberry para el controlador de impresiones; las impresoras deben ser de red. El kit se cotiza con el equipo de Desarrollo de Negocios."
  ],
  "R48": [
   "Switch por falta de puertos en el router",
   "Implementar un switch y los puntos de red que faltan: un extremo de cada cable en el router/switch (la central) y el otro junto a cada equipo (impresora, PC, Raspberry). Indicar al cliente cuántos puntos de red debe implementar y el tamaño del switch (5, 8, 16 o 24 puertos)."
  ],
  "R49": [
   "Punto de energía junto a cada equipo de red",
   "Habilitar un punto de energía junto a cada equipo de red (switch, Raspberry, impresora de red, access point, repetidor). Si no es posible, indicar que necesitará un punto de energía adicional o una extensión."
  ],
  "R51": [
   "Impresoras de áreas de preparación: siempre de red",
   "Las impresoras de áreas de preparación (cocina, bar, jugos, brasas…) deben ser de red, conectadas por cable. Si es USB o Bluetooth, cambiarla por una impresora de red; si es WiFi, conectarla por cable."
  ],
  "R53": [
   "Cámaras: plan de 1 Gbps y red separada",
   "Contratar un plan de 1 Gbps (1000 Mbps) y separar la red de cámaras de la red de PC, sistema de impresiones e impresoras de red (VLAN o router aparte), para que las cámaras no consuman la velocidad del sistema."
  ],
  "R55": [
   "Impresoras en el segmento del router",
   "Cambiar la IP de la impresora a una del segmento del router (ej. router 192.168.1.1 → impresora 192.168.1.50), con DHCP desactivado, y volver a subir el autotest."
  ],
  "R56": [
   "Red independiente con TP-Link y chip",
   "Independizar la red con un TP-Link con chip y plan básico, solo para las impresoras y el equipo donde va el sistema de impresiones. Reemplaza al internet del local para la impresión (no es un respaldo); el chip (Entel o Claro) sale de la prueba de señal."
  ],
  "R58": [
   "Switch de 1000 Mbps",
   "Cambiar el switch por uno de 10/100/1000 Mbps (gigabit) con los puertos necesarios."
  ],
  "R59": [
   "Ponchar los cables con la norma B",
   "Ponchar de nuevo el cable con la norma T568B en ambos extremos (router → switch → impresora) y probar la conexión."
  ],
  "R60": [
   "PC o laptop temporal: Raspberry",
   "Tomarlo como si no hubiera PC: recomendar el kit Raspberry para el sistema de impresiones (o una PC fija del local)."
  ],
  "R61": [
   "Probar los puertos del router",
   "Probar cada puerto del router, anotar en qué puerto queda cada impresora y no cambiarla de puerto."
  ],
  "R62": [
   "Cables de cámaras lejos de la corriente",
   "Canaletear el cable de red lejos de los cables de corriente y de los equipos con motor (por tubo desde el techo o por el piso)."
  ],
  "R63": [
   "Periféricos de caja y pruebas de funcionamiento",
   "Probar en cada caja la impresión, la gaveta, el escáner, la balanza, la impresora de etiquetas y el POS de pago antes del inicio; definir qué balanza queda operativa."
  ],
  "R64": [
   "Reestructurar el cableado de red",
   "Reestructurar el cableado de red con canaletas y rotulado. No impide el inicio."
  ],
  "R65": [
   "Velocidad limitada a 100 Mbps",
   "Repetir la prueba directo al router principal, con cable Cat6 y en un puerto RJ45 gigabit (10/100/1000) en el router y en la PC o laptop; si se confirma, cambiar el switch o el cable."
  ]
 },
